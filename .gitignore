# Environment & secrets
.env
.env.*
!.env.example

# Makefile runtime (PID + log của backend/client khi chạy `make start`)
.run/

# Local seed / credentials (use register.example.json)
register.json

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]

# Logs
*.log
# Production exports, incident reports, and one-shot data repair scripts
REPAIR_REPORT_*.txt
server/_phase*_backup_*.json
server/scripts/import_*.py
server/scripts/capture_*_frames.py
logs/
!client/src/features/logs/

# Playwright MCP local snapshots
.playwright-mcp/

# Local Docker-mounted data (PostgreSQL/MinIO)
server/app/data-docker/

# Pipeline temp media (video record, OCR audit, seam baselines)
server/app/runtime-media/

# Training snapshot crops (collected at runtime)
server/snapshot/

# Fine-tune datasets, prepared splits, and training runs
fine-tune/

# Local DB export blobs (images/videos under sql dumps — do not version)
server/app/db/sqlCommand/detections/

# Local cuDNN 8 symlinks for paddlepaddle-gpu 2.6.x (host-specific)
server/.cudnn8/

# YOLO model weights (binary, tracked out-of-band)
*.pt

# Model AI khác: engine TensorRT gắn cứng GPU/phiên bản TRT, build lại bằng
# `make engines` trên từng máy — không commit. Xem server/models/.
*.engine
*.plan
*.onnx
*.trt
*.safetensors
# Model PaddleOCR tải sẵn (inference.pdiparams 60-80MB mỗi model)
server/models/paddle_ocr/

# Ultralytics training/predict runs
runs/
