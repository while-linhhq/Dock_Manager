# Zalo Bot — unknown ship identity notifications
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
# Bot riêng chỉ gửi cảnh báo nghiệp vụ. Chat ID phải thuộc bot này.
ZALO_ALERT_BOT_TOKEN=
ZALO_ALERT_CHAT_ID=
ZALO_WEBHOOK_SECRET=
ZALO_ENABLED=false
# Public HTTPS base URL (no trailing slash), e.g. https://your-domain.com
ZALO_PUBLIC_BASE_URL=
# Base công khai để dựng URL ảnh/video media mở được từ trình duyệt ở xa (để trống thì
# lấy ZALO_PUBLIC_BASE_URL, rồi mới tới origin của chính request).
PUBLIC_BASE_URL=
# Optional webhook base for setWebhook (defaults to ZALO_PUBLIC_BASE_URL)
ZALO_WEBHOOK_BASE_URL=
# Enable long-polling fallback when Cloudflare blocks Zalo webhook (error 1010)
ZALO_POLLING_ENABLED=false
# Short-link TTL for Zalo media URLs (hours)
ZALO_MEDIA_TTL_HOURS=168
# Defer Zalo notify until MinIO has image (+ video when pipeline expects it)
ZALO_NOTIFY_MEDIA_WAIT_SEC=180
ZALO_NOTIFY_MEDIA_POLL_SEC=3

# Visual ReID (DINOv2 + Qdrant)
ENABLE_VISUAL_ID=true
VISUAL_ID_INTERVAL_SEC=1.0
VISUAL_MIN_CROP_AREA=4096
VISUAL_MATCH_THRESHOLD=0.55
VISUAL_TOP_K=20
VISUAL_MODEL_PATH=
VISUAL_BACKBONE=vit_base_patch14_dinov2
VISUAL_EMBEDDING_DIM=768
VISUAL_IMAGE_SIZE=224
VISUAL_BATCH_SIZE=8
VISUAL_DEVICE=0
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vessel_visual_embeddings_dinov2
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=COSINE
QDRANT_TIMEOUT_SEC=15

# --- Tối ưu pipeline (2026-09-29) ---
# CLAHE: true = cân bằng sáng uint8 (~10x nhanh hơn bản float32, lệch TB ~1.3 mức uint8)
CLAHE_FAST=true
# Tỉ lệ frame đưa vào detector: 1.0 = nguyên frame (mặc định), 0.5 = nhanh hơn ~2x nhưng box lệch nhẹ (chạy make ab-detect trước)
DETECT_SCALE=1.0
CROP_PAD_RATIO=0.05
# CLAHE ở kích thước detector (letterbox trước): true = nhanh hơn ~39ms/frame, box lệch IoU min 0.9935
CLAHE_AFTER_LETTERBOX=true
# Hệ số letterbox trước CLAHE: 1.0 nhanh nhất nhưng mất box (đo trên cam6), 1.5 giữ đủ box
CLAHE_LETTERBOX_SCALE=1.5
